{
    "name": "admin-api",
    "version": "1.0.0",
    "description": "Admin API for database management",
    "main": "dist/server.js",
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/server.js",
        "dev": "tsx watch server.ts",
        "typecheck": "tsc --noEmit",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.24.0",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.966.0",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "google-auth-library": "^10.5.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.0.2",
        "mysql2": "^3.15.3"
    },
    "devDependencies": {
        "@jest/globals": "^30.5.2",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.3.0",
        "@types/node": "^22.20.5",
        "@types/supertest": "^7.2.1",
        "jest": "^30.2.0",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.14",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3"
    }
}
